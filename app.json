{
  "expo": {
    "name": "Glow - Beauty & Skincare",
    "slug": "beauty-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Glow needs camera access for skin analysis and virtual makeup try-on."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF5F5"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.beautyapp"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Glow needs camera access for skin analysis."
        }
      ],
      "expo-video",
      "expo-status-bar",
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d2c395ef-51ae-460d-a55c-24f70cddb0d8"
      }
    },
    "owner": "mohamad.hamad"
  }
}
